# Copy to .env and fill in real values to run in "live" mode.
# Leave API_KEY empty to run in built-in "demo" mode.

APP_NAME=AgriAI Assistant

# OpenAI-compatible provider credentials.
# For OpenAI:  API_KEY=sk-...  BASE_URL=https://api.openai.com/v1
# For OpenRouter or another gateway, set BASE_URL to that service.
API_KEY=
BASE_URL=https://api.openai.com/v1

# Must be an explicitly vision-capable model, e.g. gpt-4o-mini.
MODEL_NAME=gpt-4o-mini

# Per-request timeout in seconds.
REQUEST_TIMEOUT=60
